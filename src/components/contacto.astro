---
import ContentSection from "~/components/content-section.astro";
const { site } = Astro;
---

<ContentSection title="Tap In" id="contact">
  <Fragment slot="lead">
    <p class="text-center">
      Boost your brand with Jersey Club—leverage our music, livestreams, and blockchain tech to monetize fan engagement on-chain.
    </p>
  </Fragment>

  <section>
    <div class="mx-auto px-4 py-8 mobile:min-w-96 md:min-w-176 lg:py-6">
      <form
        class="space-y-8"
        accept-charset="UTF-8"
        name="contact-form"
        action="https://formsubmit.co/play@jersey.fm"
        method="POST"
      >
        <div class="flex flex-col gap-4 lg:flex-row">
          <div class="w-full">
            <label for="name" class="mb-2 block text-sm font-medium">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="block w-full rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default shadow-sm placeholder-default"
              placeholder="Wizard of Hahz"
              required
            />
          </div>

          <div class="w-full">
            <label for="email" class="mb-2 block text-sm font-medium">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="block w-full rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default shadow-sm placeholder-default"
              placeholder="info@example.com"
              required
            />
          </div>
        </div>

        <div class="sm:col-span-2">
          <label for="message" class="mb-2 block text-sm font-medium">
            Your Message
          </label>
          <textarea
            id="message"
            rows="6"
            minlength="10"
            name="message"
            class="block max-h-60 min-h-24 w-full rounded-lg border border-input bg-contactInput p-2.5 text-sm text-default shadow-sm placeholder-default"
            placeholder="I want to promote my Jersey Club music"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="mobile:min-w-96 md:min-w-176 min-w-72 rounded-lg bg-gradient-to-br from-yellow-500 to-yellow-600 px-5 py-3 text-center text-sm font-medium text-white duration-300 hover:scale-105 focus:outline-none focus:ring-4"
        >
          Send Message
        </button>

        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_next" value={site} />
        <input type="hidden" name="_template" value="box" />
        <input type="hidden" name="_cc" value="play@jersey.fm" />
      </form>
    </div>
  </section>
</ContentSection>
