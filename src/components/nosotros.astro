---
import ContentSection from "~/components/content-section.astro";
import Perfiles from "~/components/perfiles.astro";
import MisionVision from "~/components/mision-vision.astro";
---

<ContentSection title="MUSIK INDUSTRY" id="blockchain-label">
  <Fragment slot="lead">
    <p class="lead-text">
      <strong>Jersey Club Blockchain Record Label</strong> –
      Revolutionizing artist partnerships through Bitcoin MU$IK,
      smart contract deals, digital merch, and transparent royalty distributions.
    </p>

    <div class="features-grid">
      <div class="feature">
        <span class="icon">🎵</span>
        <h3><b>Royalty Payments</b></h3>
        <p>Instant, transparent splits via self-executing smart contracts</p>
      </div>

      <div class="feature">
        <span class="icon">🛒</span>
        <h3><b>Digital Merch</b></h3>
        <p>NFT collectibles, limited editions, and unlockable content</p>
      </div>

      <div class="feature">
        <span class="icon">📜</span>
        <h3><b>Ownership Rights</b></h3>
        <p>Immutable proof of IP stored on-chain</p>
      </div>
    </div>

    <p class="tagline">
      Built for the <strong>Jersey Club musik</strong> —
      industry only fans own.
    </p>
  </Fragment>

  <MisionVision />
  <!-- <Perfiles /> -->
</ContentSection>
