---
import ContentSection from "~/components/content-section.astro";
import type { ServiceItem } from "~/types";

const services: Array<ServiceItem> = [
  {
    title: "MU$IK",
    subtitle: "Exit 1",
    description: "Take a LUV NFT FUN course to learn how to sell Bitcoin MU$IK as an artist or fan!",
    img: "emoji-Hahz",
    link: "https://fun.luvnft.com/courses/bitcoin-ordinals-for-beginners-%f0%9f%aa%99%f0%9f%92%96/"
  },
  {
    title: "LIVE",
    subtitle: "Events",
    description: "Contact us to schedule a live event for your JERSEY.FM release.",
    img: "emoji-Live",
    link: "/live"
  },
  {
    title: "TV",
    subtitle: "Raw & Uncut",
    description: "TV is the TikTok-like Jersey Club platform for audio video reels.",
    img: "emoji-TV",
    link: "/tv"
  },
  {
    title: "ADS",
    subtitle: "Paid",
    description: "We run and manage paid ad campaigns on Google, TikTok, IG & Facebook for artists.",
    img: "emoji-PPV",
    link: "/ads"
  },
  {
    title: "PODCAST",
    subtitle: "Jersey Club Podcast",
    description: "Search on TikTok for our Jersey Club Podcast AR Effect filter and leave a reel-review to be featured on TV.",
    img: "emoji-Mic",
    link: "/podcast"
  },
  {
    title: "MEMECOINS",
    subtitle: "Social",
    description: "We transform Jersey Club music releases into viral memecoin campaigns—measuring artist buzz and fan engagement through blockchain-powered metrics.",
    img: "emoji-Ads",
    link: "/memecoins"
  },
  {
    title: "COVER ART",
    subtitle: "Branded",
    description: "Get branded cover art for your Jersey Club music that fans can buy as digital merch.",
    img: "emoji-Camera",
    link: "/cover-art"
  },
  {
    title: "CHALLENGE",
    subtitle: "Win Bitcoin",
    description: "Join our social challenges to win Bitcoin or crypto.",
    img: "emoji-Tip",
    link: "/challenge"
  },
];
---

<ContentSection title="Route 9" id="solutions">
  <Fragment slot="lead">
    Take a trip down the Route 9 of Jersey Club exits.
  </Fragment>

  <div class="space-y-16">
    {services.map((service, index) => (
      <div class="max-w-6xl mx-auto" key={index}>
        {index % 2 === 0 ? (
          <div class="md:flex md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-end md:text-end">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500 text-balance">
                {service.description}
              </p>
              <a href={service.link} class="mt-4 inline-block rounded-lg bg-primary px-6 py-3 text-white hover:bg-primary-dark transition-colors">
                Explore Now
              </a>
            </div>
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col-reverse md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-start md:text-start">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500">
                {service.description}
              </p>
              <a href={service.link} class="mt-4 inline-block rounded-lg bg-primary px-6 py-3 text-white hover:bg-primary-dark transition-colors">
                Explore Now
              </a>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</ContentSection>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap');
</style>