---
import ContentSection from "~/components/content-section.astro";
import type { ServiceItem } from "~/types";

const services: Array<ServiceItem> = [
  {
    title: "MU$IK",
    subtitle: "Bitcoin",
    description: "Support Jersey Club artists directly by purchasing digital merch or tipping in Bitcoin MU$IK—fully on-chain, fully transparent. See who's trending in real time.",
    img: "emoji-Hahz",
    list1: "Strategic management of communication across relevant social media platforms",
    list2: "Amplification of your brand in digital landscapes",
    list3: "Enhancement of your tokenized digital properties",
    list4: "Continuous optimization of your digital presence",
  },
  {
    title: "LIVE",
    subtitle: "Events",
    description: "Contact us to schedule a live event for your JERSEY.FM release.",
    img: "emoji-Live",
    list1: "High-impact advertising strategies across multiple platforms",
    list2: "Driving qualified traffic to your digital properties",
    list3: "Focus on generating sales and capturing leads",
    list4: "Maximizing return on your online presence",
  },
  {
    title: "TV",
    subtitle: "Raw & Uncut",
    description: "TV is the TikTok-like Jersey Club platform for audio video reels.",
    img: "emoji-TV",
    list1: "Create affordable CRE rentals",
    list2: "Development of effective strategies through data analysis",
    list3: "Continuous improvement for success",
    list4: "Focus on optimization and long-term growth",
  },
  {
    title: "ADS",
    subtitle: "Paid",
    description: "We run and manage paid ad campaigns on Google, TikTok, IG & Facebook for artists.",
    img: "emoji-PPV",
    list1: "Design of high-impact social media campaigns",
    list2: "Focus on sales, lead generation, and branding",
    list3: "Drive short-term business success",
    list4: "Campaigns to increase engagement",
  },
  {
    title: "PODCAST",
    subtitle: "Jersey Club Podcast",
    description: "Search on TikTok for our Jersey Club Podcast AR Effect filter and leave a reel-review to be featured on TV.",
    img: "emoji-Mic",
    list1: "Custom websites reflecting your brand essence",
    list2: "Responsive across all devices",
    list3: "Engaging design that captivates",
    list4: "Latest technologies for optimal presence",
  },
  {
    title: "MEMECOINS",
    subtitle: "Social",
    description: "We transform Jersey Club music releases into viral memecoin campaigns—measuring artist buzz and fan engagement through blockchain-powered metrics.",
    img: "emoji-Ads",
    list1: "Captivating videos that amplify your message",
    list2: "Expert editing for organic growth",
    list3: "Effective on TikTok and Instagram",
    list4: "Maximize video content impact",
  },
  {
    title: "COVER ART",
    subtitle: "Branded",
    description: "Get branded cover art for your Jersey Club music that fans can buy as digital merch.",
    img: "emoji-Camera",
    list1: "Strategies to boost online presence",
    list2: "Search engine ranking optimization",
    list3: "Increase potential customers",
    list4: "Fuel business growth",
  },
  {
    title: "CHALLENGE",
    subtitle: "Win Bitcoin",
    description: "Join our social challenges to win Bitcoin or crypto.",
    img: "emoji-Tip",
    list1: "Advanced online presence strategies",
    list2: "Organic search optimization",
    list3: "Increase website traffic",
    list4: "Effective business growth strategies",
  },
];
---

<ContentSection title="How We Do It" id="solutions">
  <Fragment slot="lead">
    We transform music to MU$IK with blockchain technology
  </Fragment>

  <div class="space-y-16">
    {services.map((service, index) => (
      <div class="max-w-6xl mx-auto" key={index}>
        {index % 2 === 0 ? (
          <div class="md:flex md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-end md:text-end">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500 text-balance">
                {service.description}
              </p>
            </div>
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col-reverse md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-start md:text-start">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500">
                {service.description}
              </p>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</ContentSection>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Color+Emoji&display=swap');
</style>
