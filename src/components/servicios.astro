---
import ContentSection from "~/components/content-section.astro";
import type { ServiceItem } from "~/types";

const services: Array<ServiceItem> = [
  {
    title: "MU$IK",
    subtitle: "Exit 1",
    description: "Take a LUV NFT FUN course to learn how to sell Bitcoin MU$IK as an artist or fan!",
    emoji: "🎶",
    link: "https://fun.luvnft.com/courses/bitcoin-ordinals-for-beginners-%f0%9f%aa%99%f0%9f%92%96/"
  },
  {
    title: "TV",
    subtitle: "Exit 2",
    description: "The MTV of Jersey Club videos fans can buy and sell.",
    emoji: "📺",
    link: "http://tv.jersey.fm"
  },
  {
    title: "Jersey Club",
    subtitle: "Exit 3",
    description: "Join the Metaverse Jersey Club to mix and mingle.",
    emoji: "🎉",
    link: "https://www.spatial.io/s/jerseyclubs-Digital-Hangout-6812bd5f5e2a67a19304853d"
  },
  {
    title: "TikTok",
    subtitle: "Exit 4",
    description: "Follow us on TikTok.",
    emoji: "🎥",
    link: "https://tiktok.com/@jerseyclubtv"
  },
  {
    title: "PODCAST",
    subtitle: "Exit 5",
    description: "Jersey Club TikTok Podcast launching soon",
    emoji: "🎙️",
    link: "/podcast"
  },
  {
    title: "JERSEY CLUB",
    subtitle: "Exit 6",
    description: "Pump your fav Jersey Club musik, chat and chill in the LUV NFT FUN club.",
    emoji: "📣",
    link: "https://fun.luvnft.com/groups/jersey-club-fm/"
  },
  {
    title: "VINYL",
    subtitle: "Exit 7",
    description: "Connect your Spotify with our Vinyl Record Player.",
    emoji: "🎵",
    link: "https://vinyl.jersey.fm"
  },
  {
    title: "$JERSEY",
    subtitle: "Exit 8",
    description: "Buy Solana $JERSEY memecoins to tip creators and dancers in our TikTok lives and Jersey Club livestreams.",
    emoji: "💸",
    link: "https://pump.fun/coin/FM5eNvujxrqYEnzsfSDTT1NGDXkP49sAQbCNQ6XNpump"
  },
];
---

<ContentSection title="Route 9" id="solutions">
  <Fragment slot="lead">
    Take a trip down the Route 9 of Jersey Club exits.
  </Fragment>

  <div class="space-y-16">
    {services.map((service, index) => (
      <div class="max-w-6xl mx-auto" key={index}>
        <div class={`md:flex ${index % 2 === 0 ? 'md:flex-row' : 'flex-col-reverse md:flex-row'} lg:min-h-[27rem] 2xl:min-h-[35rem]`}>
          <div class="my-6 flex justify-center md:my-12 md:w-1/2">
            <div class="m-auto w-full max-w-[1024px]">
              <span class="block text-[25vw] md:text-[20rem] leading-none font-bold text-primary text-center">
                {service.emoji}
              </span>
            </div>
          </div>
          <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:text-start md:items-start">
            <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
              {service.subtitle}
            </h3>
            <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
              {service.title}
            </h2>
            <p class="text-base font-normal text-gray-500 text-balance">
              {service.description}
            </p>
            <a href={service.link} class="exit-button mt-4 inline-block">
              EXIT
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</ContentSection>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Highway+Gothic&display=swap');

  .exit-button {
    font-family: 'Highway Gothic', Arial, sans-serif;
    background-color: #005f25;
    color: #ffd700;
    border: 3px solid #ffd700;
    padding: 0.5rem 1.5rem;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    transition: all 0.3s ease;
    letter-spacing: 1px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .exit-button:hover {
    background-color: #004a1c;
    color: #ffea66;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }

  body.dark-theme .exit-button {
    background-color: #004a1c;
    color: #ffdf33;
    border-color: #ffdf33;
  }

  body.dark-theme .exit-button:hover {
    background-color: #003814;
    color: #ffea66;
  }
</style>
