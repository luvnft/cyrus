---
import ContentSection from "~/components/content-section.astro";
import type { ServiceItem } from "~/types";

const services: Array<ServiceItem> = [
  {
    title: "MU$IK",
    subtitle: "Exit 1",
    description: "Take a LUV NFT FUN course to learn how to sell Bitcoin MU$IK as an artist or fan!",
    img: "emoji-Hahz",
    link: "https://fun.luvnft.com/courses/bitcoin-ordinals-for-beginners-%f0%9f%aa%99%f0%9f%92%96/"
  },
  {
    title: "TV",
    subtitle: "Exit 2",
    description: "The MTV of Jersey Club videos fans can buy and sell.",
    img: "emoji-TV",
    link: "http://tv.jersey.fm"
  },
  {
    title: "Jersey Club",
    subtitle: "Exit 3",
    description: "Join the Metaverse Jersey Club to mix and mingle.",
    img: "emoji-Live",
    link: "https://www.spatial.io/s/jerseyclubs-Digital-Hangout-6812bd5f5e2a67a19304853d"
  },
  {
    title: "TikTok",
    subtitle: "Exit 4",
    description: "Follow us on TikTok.",
    img: "emoji-PPV",
    link: "https://tiktok.com/@jerseyclubtv"
  },
  {
    title: "PODCAST",
    subtitle: "Exit 5",
    description: "Jersey Club TikTok Podcast launching soon",
    img: "emoji-Mic",
    link: "/podcast"
  },
  {
    title: "JERSEY CLUB",
    subtitle: "Exit 6",
    description: "Pump your fav Jersey Club musik, chat and chill in the LUV NFT FUN club.",
    img: "emoji-Ads",
    link: "https://fun.luvnft.com/groups/jersey-club-fm/"
  },
  {
    title: "VINYL",
    subtitle: "Exit 7",
    description: "Connect your Spotify with our Vinyl Record Player.",
    img: "emoji-Camera",
    link: "https://vinyl.jersey.fm"
  },
  {
    title: "$JERSEY",
    subtitle: "Exit 8",
    description: "Buy Solana $JERSEY memecoins to tip Jersey Musik creators and dancers during our upcoming livestream shows.",
    img: "emoji-Tip",
    link: "https://pump.fun/coin/FM5eNvujxrqYEnzsfSDTT1NGDXkP49sAQbCNQ6XNpump"
  },
];
---

<ContentSection title="Route 9" id="solutions">
  <Fragment slot="lead">
    Take a trip down the Route 9 of Jersey Club exits.
  </Fragment>

  <div class="space-y-16">
    {services.map((service, index) => (
      <div class="max-w-6xl mx-auto" key={index}>
        {index % 2 === 0 ? (
          <div class="md:flex md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-end md:text-end">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500 text-balance">
                {service.description}
              </p>
              <a href={service.link} class="mt-4 inline-block px-8 py-4 text-2xl font-bold uppercase turnpike-button">
                Learn More
              </a>
            </div>
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-8xl md:text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
          </div>
        ) : (
          <div class="flex flex-col-reverse md:flex-row lg:min-h-[27rem] 2xl:min-h-[35rem]">
            <div class="my-6 flex justify-center md:my-12 md:w-1/2">
              <div class="m-auto max-w-80 md:max-w-sm 2xl:max-w-lg">
                <span class={`text-8xl md:text-4xl font-bold text-primary ${service.img}`}></span>
              </div>
            </div>
            <div class="flex flex-col justify-center p-4 text-center md:w-1/2 md:items-start md:text-start">
              <h3 class="mb-2 text-lg font-semibold text-gray-500 md:text-base">
                {service.subtitle}
              </h3>
              <h2 class="gradient-text mb-6 text-4xl font-extrabold md:mb-7 md:text-6xl">
                {service.title}
              </h2>
              <p class="text-base font-normal text-gray-500">
                {service.description}
              </p>
              <a href={service.link} class="mt-4 inline-block px-8 py-4 text-2xl font-bold uppercase turnpike-button">
                Learn More
              </a>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</ContentSection>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Highway+Gothic&display=swap');

  /* Improved emoji font stack */
  @font-face {
    font-family: 'EmojiFallback';
    src: local('Apple Color Emoji'),
         local('Segoe UI Emoji'),
         local('Segoe UI Symbol'),
         local('Noto Color Emoji');
    unicode-range: U+1F000-1F644, U+203C-3299;
  }

  .turnpike-button {
    font-family: 'Highway Gothic', Arial, sans-serif;
    background-color: #005f25;
    color: #ffd700;
    border: 4px solid #ffd700;
    border-radius: 0;
    position: relative;
    text-decoration: none;
    transition: all 0.3s ease;
    letter-spacing: 1.5px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
    margin-top: 1.5rem;
  }

  .turnpike-button:hover {
    background-color: #004a1c;
    color: #ffea66;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3);
  }

  .turnpike-button::before {
    content: "EXIT";
    position: absolute;
    top: -1.5rem;
    left: 50%;
    transform: translateX(-50%);
    background-color: #005f25;
    color: white;
    padding: 0.25rem 1rem;
    font-size: 1rem;
    border: 3px solid #ffd700;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    font-weight: bold;
  }

  /* Emoji styling with fallback */
  [class^="emoji-"] {
    font-family: 'EmojiFallback', 'Noto Color Emoji', 'Apple Color Emoji', 'Segoe UI Emoji', sans-serif;
    font-size: 4rem;
    line-height: 1;
    display: inline-block;
  }

  /* Responsive emoji sizing */
  @media (min-width: 768px) {
    [class^="emoji-"] {
      font-size: 3rem;
    }
  }

  /* Dark theme adjustments */
  body.dark-theme .turnpike-button {
    background-color: #004a1c;
    color: #ffdf33;
    border-color: #ffdf33;
  }

  body.dark-theme .turnpike-button:hover {
    background-color: #003814;
    color: #ffea66;
  }

  body.dark-theme .turnpike-button::before {
    background-color: #004a1c;
    border-color: #ffdf33;
  }
</style>