---

<ContentSection title="Route 9" id="solutions">
  <Fragment slot="lead">
    Take a trip down the Route 9 of Jersey Club exits.
  </Fragment>

  <div class="space-y-16">
    {services.map((service, index) => (
      <div class="max-w-6xl mx-auto" key={index}>
        <div class={`md:flex ${index % 2 === 0 ? 'flex-row' : 'flex-row-reverse'} items-center lg:min-h-[27rem] gap-8`}>
